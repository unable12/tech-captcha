{
  "name": "tech-captcha",
  "version": "0.1.1",
  "description": "A captcha for people who have opinions about Sand Hill Road.",
  "license": "MIT",
  "author": "Kamil Ruczynski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unable12/tech-captcha.git"
  },
  "homepage": "https://github.com/unable12/tech-captcha#readme",
  "bugs": {
    "url": "https://github.com/unable12/tech-captcha/issues"
  },
  "keywords": [
    "captcha",
    "web-component",
    "custom-element",
    "shadow-dom",
    "bot-detection",
    "prompt-injection",
    "honeypot",
    "san-francisco",
    "no-dependencies",
    "typescript"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/tech-captcha.js",
  "exports": {
    ".": "./dist/tech-captcha.js",
    "./server": "./dist/server.js",
    "./packs": "./dist/packs.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.server.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "npm run build && node test/server.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
